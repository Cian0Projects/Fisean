# Físeán configuration. Copy to .env.local for local development.

# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Where the SQLite database lives.
DATABASE_PATH=./data/fisean.db

# Storage adapter: "local" writes to MEDIA_DIR. "s3" is for later deployment.
STORAGE_DRIVER=local
MEDIA_DIR=./data/media

# Optional. If ffmpeg is on PATH, Físeán will build HLS renditions, a 360p
# scrub proxy and sprite filmstrips. Without it, playback falls back to
# direct MP4 range requests and filmstrips are generated in the browser.
# FFMPEG_PATH=ffmpeg

# Físeán configuration. Copy to .env.local for local development.

# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Where the SQLite database lives.
DATABASE_PATH=./data/fisean.db

# Where footage lives. "local" keeps it in MEDIA_DIR, behind the app's own
# stand-in for R2 — uploads and playback go through the same signed-link steps
# as the hosted app, so this is how to try the real thing without a bucket.
# "r2" uses a Cloudflare R2 bucket and needs the four R2_ settings below.
STORAGE_DRIVER=local
MEDIA_DIR=./data/media

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ardawn-footage
# Set to "eu" when the bucket was created under the EU jurisdiction, which
# gives it its own hostname. Leave unset for a bucket with no jurisdiction.
# R2_JURISDICTION=eu

# The site's public address. Required in production: every link in an email
# (sign-in links, share emails, unsubscribe) is built from it, never from the
# request, so a forged Host header cannot send a player's sign-in link elsewhere.
# APP_URL=https://ardawnsport.ie

# Email. With ZEPTOMAIL_TOKEN set, sign-in codes and share emails go through
# Zoho ZeptoMail; without it they are written to MAIL_OUTBOX and printed in the
# terminal, which is all a laptop needs. Paste the agent's Send Mail token as
# the dashboard copies it, "Zoho-enczapikey ..." and all.
# ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_HOST=api.zeptomail.eu
# MAIL_FROM=no-reply@ardawnsport.ie
# MAIL_DRIVER=local     # force the outbox even with a token set
# MAIL_OUTBOX=./data/outbox

# Where a new club waiting to be checked is emailed, with the link to approve
# or decline it. Anyone can set up a club at /start; nothing opens until then.
# HOST_EMAIL=hello@ardawnsport.ie

# Where to email when the server throws an error: route, method, message and
# stack, no cookies or request bodies. Unset means no alerts. Only severe errors
# (database, disk, storage keys) and ones that repeat (3 times in 15 minutes) are
# sent, once an hour per distinct error, 20 a day at most.
# ALERT_EMAIL=

# The nightly storage sweep (npm run reconcile) finds footage in the bucket
# that no video uses. It only reports, by email to ALERT_EMAIL, until this is
# set to exactly 1; then it also removes what has been unused for several
# nights. Leave it off for the first few nights and read the emails.
# RECONCILE_DELETE=1

# The storage tier a NEW club starts on, in gigabytes. Each club's own tier is
# kept on the club (change one with: npm run set-storage -- --email <admin> --gb 250),
# so editing this changes nothing for clubs that already exist. One instance
# hosts many clubs; the tier stops one club's season filling the disk for the
# rest. Default 100. 50 is about 15 matches, the free founding period's allowance.
# Whatever the tier, no single file may be over 20 GB.
# TEAM_STORAGE_GB=100

# Where npm run backup keeps its nightly database snapshots. With
# STORAGE_DRIVER=r2 each one is also sent to the bucket under backups/.
# BACKUP_DIR=./data/backups

# Optional. If ffmpeg is on PATH, Físeán will build HLS renditions, a 360p
# scrub proxy and sprite filmstrips. Without it, playback falls back to
# direct MP4 range requests and filmstrips are generated in the browser.
# FFMPEG_PATH=ffmpeg

# Físeán configuration. Copy to .env.local for local development.

# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Where the SQLite database lives.
DATABASE_PATH=./data/fisean.db

# Where footage lives. "local" keeps it in MEDIA_DIR, behind the app's own
# stand-in for R2 — uploads and playback go through the same signed-link steps
# as the hosted app, so this is how to try the real thing without a bucket.
# "r2" uses a Cloudflare R2 bucket and needs the four R2_ settings below.
STORAGE_DRIVER=local
MEDIA_DIR=./data/media

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ardawn-footage
# Set to "eu" when the bucket was created under the EU jurisdiction, which
# gives it its own hostname. Leave unset for a bucket with no jurisdiction.
# R2_JURISDICTION=eu

# When set, /start asks for this before a new club can be created, so only
# clubs you have given it to can sign up. Unset, anyone can.
# SIGNUP_CODE=

# Footage each club may store, in gigabytes. One instance hosts many clubs, so
# this stops one club's season filling the disk for the rest. Default 100.
# TEAM_STORAGE_GB=100

# Optional. If ffmpeg is on PATH, Físeán will build HLS renditions, a 360p
# scrub proxy and sprite filmstrips. Without it, playback falls back to
# direct MP4 range requests and filmstrips are generated in the browser.
# FFMPEG_PATH=ffmpeg
